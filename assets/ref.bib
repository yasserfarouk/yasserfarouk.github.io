}

@inproceedings{mohammad2007intention,
  abstract  = {Human-Artifact interaction in real world situations is currently an active area of research due to the importance foreseen of the social capabilities of near future robots and other intelligent artifacts in integrating them into the human society. In this paper a new paradigm for mutual intention in human-artifact interactions based on the embodied computing paradigm called is introduced with theoretical analysis of its relation to the embodiment framework. As examples of the practical use of the framework to replace traditional symbolic based intention understanding systems, the authors' preliminary work in a real-world agent architecture (IECA) and a natural drawing environment (NaturalDraw) is briefed.},
  keywords  = {conference, robotics},
  author    = {Yasser F. O. Mohammad and Toyoaki Nishida},
